generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  createdAt     DateTime      @default(now())
  savedSearches     SavedSearch[]
  alerts            Alert[]
  favouriteProperties FavouriteProperty[]
}

model HistoricalMetric {
  id         Int      @id @default(autoincrement())
  source     String
  metric     String
  geography  String
  period     String
  value      Float
  unit       String
  createdAt  DateTime @default(now())

  @@unique([source, metric, geography, period])
  @@index([metric, geography, period])
  @@index([geography])
}

model ListingCurrent {
  id             String   @id @default(cuid())
  externalId     String
  source         String
  title          String
  county         String
  locality       String?
  eircode        String?
  askingPriceEur Int
  beds           Int?
  baths          Int?
  propertyType   String?
  listedAt       DateTime
  listingUrl     String
  latitude       Float?
  longitude      Float?
  isActive           Boolean  @default(true)
  previousPriceEur   Int?
  priceUpdatedAt     DateTime?
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([source, externalId])
  @@index([county, askingPriceEur, isActive])
  @@index([county, askingPriceEur, beds, isActive])
  @@index([isActive])
  @@index([listedAt])
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  name        String
  county      String?
  minPriceEur Int?
  maxPriceEur Int?
  minBeds     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts      Alert[]
}

model Alert {
  id             String      @id @default(cuid())
  userId         String
  savedSearchId  String?
  type           AlertType
  enabled        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lastTriggeredAt DateTime?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedSearch    SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
}

model FavouriteProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   PropertySale @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model IngestionRun {
  id          String   @id @default(cuid())
  source      String
  status      RunStatus
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  rowsRead    Int      @default(0)
  rowsUpserted Int     @default(0)
  error       String?
}

model PropertySale {
  id                      String   @id @default(cuid())
  sourceKey               String   @unique
  saleDate                DateTime
  address                 String
  county                  String
  eircode                 String?
  priceEur                Int
  notFullMarketPrice      Boolean
  vatExclusive            Boolean
  descriptionOfProperty   String
  propertySizeDescription String?
  latitude                Float?
  longitude               Float?
  estimatedEircode        String?
  estimatedLatitude       Float?
  estimatedLongitude      Float?
  createdAt               DateTime @default(now())
  favouriteProperties     FavouriteProperty[]

  @@index([county, saleDate])
  @@index([saleDate, priceEur])
  @@index([county, priceEur])
  @@index([eircode])
}

model VerifiedEircodeMap {
  eircode String @id
  geom    Unsupported("geometry(Point, 4326)")

  @@index([geom], map: "verified_eircode_geom_idx", type: Gist)
}



enum AlertType {
  NEW_LISTING_MATCH
  PRICE_DROP
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
}
