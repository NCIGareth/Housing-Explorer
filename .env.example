# ─── Database ───────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/housing?schema=public
DIRECT_URL=postgresql://user:pass@localhost:5432/housing?schema=public

# ─── Supabase (Auth) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key"

# ─── Email (Resend) ─────────────────────────────────
RESEND_API_KEY="re_placeholder_do_not_use"
EMAIL_FROM="onboarding@resend.dev"
ADMIN_EMAILS="admin@example.com"

# ─── SMTP Fallback (dev only) ───────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# ─── Alert Dispatch ─────────────────────────────────
DISPATCH_CRON_SECRET="change-me-to-a-random-secret"

# ─── Data Sources ───────────────────────────────────
CSO_BASE_URL="https://ws.cso.ie/public/api.restful/PxStat.Data.Cube_API.ReadDataset"
NOMINATIM_URL="http://localhost:8080"

# Re-geocoder concurrency (defaults to 25 when unset)
GEO_CONCURRENCY="25"

# ─── Rate Limiting (Upstash Redis) ─────────────────
# Get free tier at https://upstash.com — 10k commands/day
# Falls back to in-memory (local dev only) when unset
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ─── Self-hosted stack (docker-compose.prod.yml) ───
# Required by docker compose interpolation on the server.
# Set these in the server's .env alongside the vars above.
NEXT_PUBLIC_APP_VERSION="dev"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
