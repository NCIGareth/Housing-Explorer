# Build fallback to prevent Prisma from crashing during module evaluation
# when a real DATABASE_URL is not provided (e.g., during some CI/CD or local build steps)
# WARNING: This is a dummy URL for builds only. At runtime, the real DATABASE_URL
# environment variable MUST be set or this fallback will be used.
# Production DATABASE_URL should include ?pgbouncer=true when using Supabase pooler:
# postgresql://user:pass@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://build_user:build_pass@localhost:5432/build_db"
