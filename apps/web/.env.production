# Build fallback to prevent Prisma from crashing during module evaluation.
# WARNING: This is a dummy URL for builds only. At runtime, the real DATABASE_URL
# must be set via Vercel dashboard / environment — this fallback will NOT work.
#
# Required production env vars (set in Vercel dashboard, NOT in this file):
#   DATABASE_URL  (Supabase pooler URL with ?pgbouncer=true&sslmode=require)
#   DIRECT_URL    (Supabase direct connection URL with ?sslmode=require)
#   RESEND_API_KEY
DATABASE_URL="postgresql://build_user:build_pass@localhost:5432/build_db"
