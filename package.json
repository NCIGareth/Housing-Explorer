{
  "name": "ireland-housing-explorer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @housing/db db:generate",
    "db:migrate": "node scripts/prisma-with-env.mjs migrate dev",
    "db:seed": "node scripts/prisma-with-env.mjs db execute --file prisma/seed.sql --schema prisma/schema.prisma",
    "ingest": "pnpm --filter @housing/ingestion ingest",
    "db:download:ppr": "node scripts/download-ppr-all.mjs",
    "db:truncate:ppr": "node scripts/prisma-with-env.mjs db execute --schema prisma/schema.prisma -- \"TRUNCATE TABLE \\\"PropertySale\\\" RESTART IDENTITY CASCADE;\"",
    "ingest:ppr": "node scripts/run-with-root-env.mjs pnpm --filter @housing/ingestion run ppr:import --",
    "ingest:enrich": "pnpm --filter @housing/ingestion ppr:enrich:eircodes && pnpm --filter @housing/ingestion ppr:enrich:coords",
    "ingest:regeocode": "pnpm --filter @housing/ingestion ppr:regeocode",
    "ingest:sync": "pnpm ingest:ppr -- --sync && pnpm ingest:enrich",
    "db:reimport:ppr": "pnpm db:download:ppr && pnpm db:truncate:ppr && pnpm ingest:ppr --since 2014 && pnpm ingest:enrich",
    "ingest:full": "pnpm ingest && pnpm ingest:ppr && pnpm ingest:enrich",
    "start": "next start",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  },

  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": "pnpm --filter @housing/web exec eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
